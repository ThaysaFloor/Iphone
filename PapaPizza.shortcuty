# PAPA PIZZA — projeto novo; sem dependências de versões anteriores.
def gravar(pasta: File, nome: Text, sessao: Dictionary):
  anterior = files.open(folder: pasta, path: nome, error_if_missing: false)
  if anterior is not empty:
    anterior_arquivo = as_type(anterior, "File")
    nome_backup = text("\(nome).bak")
    copia = files.save(item: anterior_arquivo, folder: pasta, destination: nome_backup, ask_where: false, overwrite: true)
  json_texto = as_type(sessao, "Text")
  arquivo = as_type(json_texto, "File")
  salvo = files.save(item: arquivo, folder: pasta, destination: nome, ask_where: false, overwrite: true)
  return salvo

def quantidade(pergunta: Text) -> Number:
  resposta = input.ask(prompt: pergunta, type: "Number", ask_action_allows_decimal_numbers: false, ask_action_allows_negative_numbers: false)
  if resposta has no value:
    exit()
  numero = as_type(resposta, "Number")
  if numero < 0:
    alert("Use uma quantidade inteira igual ou maior que zero.")
    exit()
  inteiro = numbers.round(input: numero, round_mode: "Normal", to: "Ones Place")
  if inteiro != numero:
    alert("Use somente números inteiros. O item não foi salvo.")
    exit()
  return numero

shortcut:
  modo = ""
  menu("Papa Pizza"):
    case "Nova conferência":
      modo = "nova"
    case "Continuar conferência":
      modo = "continuar"
    case "Histórico e resumo":
      modo = "resumo"
    case "Sair":
      exit()
  alert("Selecione a pasta PapaPizza no iCloud Drive. Use sempre a mesma pasta para continuar conferências e consultar o histórico. Se ela ainda não existir, crie-a no aplicativo Arquivos.", title: "Pasta das conferências", cancel: true)
  pastas = files.choose(picking_mode: "Folders", select_multiple: false)
  if pastas is empty:
    exit()
  pasta_selecionada = lists.item(items: pastas, specifier: "First Item")
